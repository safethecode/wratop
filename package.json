{
  "name": "wratop",
  "productName": "wratop",
  "version": "0.1.0",
  "description": "A maintainable macOS desktop app foundation",
  "main": ".webpack/main",
  "private": true,
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22.12.0"
  },
  "packageManager": "npm@10.9.4",
  "scripts": {
    "start": "electron-forge start",
    "package": "electron-forge package",
    "make": "electron-forge make",
    "check": "npm run check:biome && npm run typecheck && npm test",
    "check:biome": "biome check .",
    "fix": "biome check --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.main.json && tsc --noEmit -p tsconfig.renderer.json && tsc --noEmit -p tsconfig.test.json"
  },
  "dependencies": {
    "@stylexjs/stylex": "0.19.0",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.11",
    "@electron-forge/cli": "7.11.2",
    "@electron-forge/maker-dmg": "7.11.2",
    "@electron-forge/maker-zip": "7.11.2",
    "@electron-forge/plugin-webpack": "7.11.2",
    "@electron-forge/shared-types": "7.11.2",
    "@electron/fuses": "2.1.3",
    "@stylexjs/unplugin": "0.19.0",
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "24.13.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "css-loader": "7.1.5",
    "electron": "44.0.0",
    "jsdom": "29.1.1",
    "mini-css-extract-plugin": "2.10.2",
    "postcss": "8.5.26",
    "postcss-loader": "8.2.1",
    "tailwindcss": "4.3.3",
    "ts-loader": "9.6.2",
    "typescript": "5.9.3",
    "vitest": "4.1.11",
    "webpack": "5.110.1",
    "webpack-cli": "7.2.3"
  }
}
